<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Crear en la orden" y "Plantilla de proyecto" también en bienes:
         el core los oculta con invisible="type != 'service'". -->
    <record id="view_product_template_form_inherit_ma_project" model="ir.ui.view">
        <field name="name">product.template.form.inherit.ma.project</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="service_tracking" position="attributes">
                <attribute name="invisible" remove="type != 'service'" separator="or"/>
            </field>
        </field>
    </record>
</odoo>
