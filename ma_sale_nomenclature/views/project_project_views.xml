<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_project_inherit_ma_related_products" model="ir.ui.view">
        <field name="name">project.project.form.inherit.ma.related.products</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Productos Relacionados" name="ma_related_products">
                    <field name="ma_related_product_tmpl_ids" widget="many2many_tags"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
