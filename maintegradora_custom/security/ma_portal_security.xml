<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_portal_assign_employees" model="res.groups">
        <field name="name">Portal: asignar empleados</field>
        <!-- v19: res.groups ya no tiene category_id, y share=True lo marca como
             grupo de compartición para poder dárselo a usuarios del portal -->
        <field name="share" eval="True"/>
        <field name="comment">Deja que un colaborador del portal vea la lista de empleados y los asigne en las tareas de los proyectos compartidos con él. Darlo solo al personal de MA, no a los clientes.</field>
    </record>

    <record id="group_portal_purchase_request" model="res.groups">
        <field name="name">Portal: solicitar compras</field>
        <field name="share" eval="True"/>
        <field name="comment">Deja que un empleado con acceso al portal cree solicitudes de cotización a proveedores. Además del grupo, el usuario debe estar ligado a un empleado activo.</field>
    </record>

    <record id="hr_employee_rule_portal_assign" model="ir.rule">
        <field name="name">Empleados visibles para colaboradores del portal</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('maintegradora_custom.group_portal_assign_employees'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
