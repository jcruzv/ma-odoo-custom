<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_employee" model="ir.ui.view">
        <field name="name">project.task.form.employee</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_project_form_employee" model="ir.ui.view">
        <field name="name">project.project.form.employee</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
