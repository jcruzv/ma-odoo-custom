<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lista de proyectos del portal con el mismo aire que la de tareas:
         encabezados, etiquetas y estado. -->
    <template id="portal_my_projects_ma" inherit_id="project.portal_my_projects" name="Proyectos portal MA">
        <xpath expr="//tbody" position="before">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Etiquetas</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end">Tareas</th>
                </tr>
            </thead>
        </xpath>
        <xpath expr="//tbody/tr/td[1]" position="after">
            <td>
                <t t-foreach="project.tag_ids" t-as="tag">
                    <span class="badge rounded-pill text-bg-light border me-1" t-out="tag.name"/>
                </t>
            </td>
            <td class="text-center">
                <t t-set="ma_status_class" t-value="{'on_track': 'text-bg-success', 'at_risk': 'text-bg-warning', 'off_track': 'text-bg-danger', 'on_hold': 'text-bg-secondary', 'done': 'text-bg-primary'}.get(project.last_update_status, 'text-bg-light border')"/>
                <span t-att-class="'badge rounded-pill ' + ma_status_class" t-field="project.last_update_status"/>
            </td>
        </xpath>
    </template>
</odoo>
